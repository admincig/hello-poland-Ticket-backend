<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>pl.hellopoland</groupId>
  <artifactId>hellopoland-ticket</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Hello Poland Ticket</name>
  <description>Hello Poland Ticket backend project</description>

  <properties>
		<maven.compiler.source>9</maven.compiler.source>
		<maven.compiler.target>9</maven.compiler.target>
		<failOnMissingWebXml>false</failOnMissingWebXml>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

  <modules>
  	<module>hellopoland-ticket-app</module>
  	<module>hellopoland-ticket-rest</module>
  	<module>hellopoland-ticket-service</module>
  	<module>hellopoland-ticket-dao</module>
  	<module>hellopoland-ticket-model</module>
  </modules>

  <dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>pl.hellopoland</groupId>
				<artifactId>hellopoland-ticket-rest</artifactId>
				<version>${project.version}</version>
				<type>jar</type>
			</dependency>
			<dependency>
				<groupId>pl.hellopoland</groupId>
				<artifactId>hellopoland-ticket-service</artifactId>
				<version>${project.version}</version>
				<type>jar</type>
			</dependency>
			<dependency>
				<groupId>pl.hellopoland</groupId>
				<artifactId>hellopoland-ticket-dao</artifactId>
				<version>${project.version}</version>
				<type>jar</type>
			</dependency>
			<dependency>
				<groupId>pl.hellopoland</groupId>
				<artifactId>hellopoland-ticket-model</artifactId>
				<version>${project.version}</version>
				<type>jar</type>
			</dependency>
			<dependency>
				<groupId>javax</groupId>
				<artifactId>javaee-api</artifactId>
				<version>7.0</version>
				<scope>provided</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>javax</groupId>
			<artifactId>javaee-api</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>
</project>