<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

  <changeSet author="KBa" id="0.0.1 - create application_properties table">
    <createSequence sequenceName="application_properties_application_property_id_seq"/>

    <createTable tableName="application_properties">
      <column autoIncrement="true" name="application_property_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="application_properties_pkey"/>
      </column>
      <column name="property_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="property_value" type="VARCHAR(255)"/>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create bookings table">
    <createSequence sequenceName="bookings_booking_id_seq"/>

    <createTable tableName="bookings">
      <column autoIncrement="true" name="booking_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="bookings_pkey"/>
      </column>
      <column name="customer_email" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="customer_name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="date" type="TIMESTAMP(6) WITHOUT TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="serial_number" type="VARCHAR(255)"/>
      <column name="status" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create email_templates table">
    <createSequence sequenceName="email_templates_email_template_id_seq"/>

    <createTable tableName="email_templates">
      <column autoIncrement="true" name="email_template_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="email_templates_pkey"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="subject" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="template" type="VARCHAR(10000)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create expired_tokens table">
    <createSequence sequenceName="expired_tokens_expired_token_id_seq"/>

    <createTable tableName="expired_tokens">
      <column autoIncrement="true" name="expired_token_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="expired_tokens_pkey"/>
      </column>
      <column name="token" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create partners table">
    <createSequence sequenceName="partners_partner_id_seq"/>

    <createTable tableName="partners">
      <column autoIncrement="true" name="partner_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="partners_pkey"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>


  <changeSet author="KBa" id="0.0.1 - create sight_events table">
    <createSequence sequenceName="sight_events_sight_event_id_seq"/>

    <createTable tableName="sight_events">
      <column autoIncrement="true" name="sight_event_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="sight_events_pkey"/>
      </column>
      <column name="active" type="BOOL">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="VARCHAR(255)"/>
      <column name="duration" type="INT"/>
      <column name="email" type="VARCHAR(255)"/>
      <column name="general_admission" type="BOOL">
        <constraints nullable="false"/>
      </column>
      <column name="main_image_url" type="VARCHAR(255)"/>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="phone" type="VARCHAR(255)"/>
      <column name="city" type="VARCHAR(255)"/>
      <column name="country" type="VARCHAR(255)"/>
      <column name="latitude" type="FLOAT8"/>
      <column name="longitude" type="FLOAT8"/>
      <column name="street" type="VARCHAR(255)"/>
      <column name="zip_code" type="VARCHAR(255)"/>
      <column name="partner_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create ticket_definitions table">
    <createSequence sequenceName="ticket_definitions_ticket_definition_id_seq"/>

    <createTable tableName="ticket_definitions">
      <column autoIncrement="true" name="ticket_definition_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="ticket_definitions_pkey"/>
      </column>
      <column name="available_tickets_number" type="INT"/>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="price" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="original_ticket_definition_id" type="BIGINT"/>
      <column name="partner_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ticket_pool_id" type="BIGINT"/>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create ticket_definitions_ticket_pool_definitions table">
    <createTable tableName="ticket_definitions_ticket_pool_definitions">
      <column name="ticketpooldefinitions_ticket_pool_definition_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ticketdefinitions_ticket_definition_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create ticket_pool_definitions table">
    <createSequence sequenceName="ticket_pool_definitions_ticket_pool_definition_id_seq"/>

    <createTable tableName="ticket_pool_definitions">
      <column autoIncrement="true" name="ticket_pool_definition_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="ticket_pool_definitions_pkey"/>
      </column>
      <column name="available_tickets_number" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="cyclical_pool" type="BOOL">
        <constraints nullable="false"/>
      </column>
      <column name="date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
      <column name="date_type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="end_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="predefined_date" type="BOOL">
        <constraints nullable="false"/>
      </column>
      <column name="start_date" type="TIMESTAMP(6) WITHOUT TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="day_of_month" type="INT"/>
      <column name="day_of_week" type="VARCHAR(255)"/>
      <column name="frequency" type="INT"/>
      <column name="frequency_type" type="VARCHAR(255)"/>
      <column name="month" type="INT"/>
      <column name="sight_event_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create ticket_pools table">
    <createSequence sequenceName="ticket_pools_ticket_pool_id_seq"/>

    <createTable tableName="ticket_pools">
      <column autoIncrement="true" name="ticket_pool_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="ticket_pools_pkey"/>
      </column>
      <column name="available_tickets_number" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
      <column name="date_type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="end_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="predefined_date" type="BOOL">
        <constraints nullable="false"/>
      </column>
      <column name="start_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
      <column name="sight_event_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>


  <changeSet author="KBa" id="0.0.1 - create tickets table">
    <createSequence sequenceName="tickets_ticket_id_seq"/>

    <createTable tableName="tickets">
      <column autoIncrement="true" name="ticket_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="tickets_pkey"/>
      </column>
      <column name="date" type="TIMESTAMP(6) WITHOUT TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="date_type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="price" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="punching_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
      <column name="serial_number" type="VARCHAR(255)"/>
      <column name="status" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="booking" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ticket_definition" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ticket_taker" type="BIGINT"/>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create user_authorities table">
    <createTable tableName="user_authorities">
      <column name="user_user_id" type="BIGINT"/>
      <column name="authorities" type="VARCHAR(255)"/>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - create users table">
    <createSequence sequenceName="users_user_id_seq"/>

    <createTable tableName="users">
      <column autoIncrement="true" name="user_id" type="SERIAL">
        <constraints primaryKey="true" primaryKeyName="users_pkey"/>
      </column>
      <column name="email" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="hidden" type="BOOL">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="password" type="VARCHAR(255)"/>
      <column name="token" type="VARCHAR(255)"/>
      <column name="partner_id" type="BIGINT"/>
    </createTable>
  </changeSet>

  <changeSet author="KBa" id="0.0.1 - add constraints">
    <addPrimaryKey
      columnNames="ticketpooldefinitions_ticket_pool_definition_id, ticketdefinitions_ticket_definition_id"
      constraintName="ticket_definitions_ticket_pool_definitions_pkey"
      tableName="ticket_definitions_ticket_pool_definitions"/>

    <addUniqueConstraint columnNames="property_name"
      constraintName="application_properties_property_name_key" tableName="application_properties"/>
    <addUniqueConstraint columnNames="serial_number" constraintName="bookings_serial_number_key"
      tableName="bookings"/>
    <addUniqueConstraint columnNames="name" constraintName="email_templates_name_key"
      tableName="email_templates"/>
    <addUniqueConstraint columnNames="token" constraintName="expired_tokens_token_key"
      tableName="expired_tokens"/>
    <addUniqueConstraint columnNames="name" constraintName="partners_name_key"
      tableName="partners"/>
    <addUniqueConstraint columnNames="serial_number" constraintName="tickets_serial_number_key"
      tableName="tickets"/>
    <addUniqueConstraint columnNames="email" constraintName="users_email_key" tableName="users"/>
    <addUniqueConstraint columnNames="token" constraintName="users_token_key" tableName="users"/>

    <addForeignKeyConstraint baseColumnNames="partner_id" baseTableName="sight_events"
      constraintName="fk_sight_events_partner_id" referencedColumnNames="partner_id"
      referencedTableName="partners"/>
    <addForeignKeyConstraint baseColumnNames="original_ticket_definition_id"
      baseTableName="ticket_definitions"
      constraintName="fk_ticket_definitions_original_ticket_definition_id"
      referencedColumnNames="ticket_definition_id" referencedTableName="ticket_definitions"/>
    <addForeignKeyConstraint baseColumnNames="partner_id" baseTableName="ticket_definitions"
      constraintName="fk_ticket_definitions_partner_id" referencedColumnNames="partner_id"
      referencedTableName="partners"/>
    <addForeignKeyConstraint baseColumnNames="ticket_pool_id" baseTableName="ticket_definitions"
      constraintName="fk_ticket_definitions_ticket_pool_id" referencedColumnNames="ticket_pool_id"
      referencedTableName="ticket_pools"/>
    <addForeignKeyConstraint baseColumnNames="sight_event_id"
      baseTableName="ticket_pool_definitions"
      constraintName="fk_ticket_pool_definitions_sight_event_id"
      referencedColumnNames="sight_event_id" referencedTableName="sight_events"/>
    <addForeignKeyConstraint baseColumnNames="sight_event_id" baseTableName="ticket_pools"
      constraintName="fk_ticket_pools_sight_event_id" referencedColumnNames="sight_event_id"
      referencedTableName="sight_events"/>
    <addForeignKeyConstraint baseColumnNames="booking" baseTableName="tickets"
      constraintName="fk_tickets_booking" referencedColumnNames="booking_id"
      referencedTableName="bookings"/>
    <addForeignKeyConstraint baseColumnNames="ticket_definition" baseTableName="tickets"
      constraintName="fk_tickets_ticket_definition" referencedColumnNames="ticket_definition_id"
      referencedTableName="ticket_definitions"/>
    <addForeignKeyConstraint baseColumnNames="ticket_taker" baseTableName="tickets"
      constraintName="fk_tickets_ticket_taker" referencedColumnNames="user_id"
      referencedTableName="users"/>
    <addForeignKeyConstraint baseColumnNames="user_user_id" baseTableName="user_authorities"
      constraintName="fk_user_authorities_user_user_id" referencedColumnNames="user_id"
      referencedTableName="users"/>
    <addForeignKeyConstraint baseColumnNames="partner_id" baseTableName="users"
      constraintName="fk_users_partner_id" referencedColumnNames="partner_id"
      referencedTableName="partners"/>
    <addForeignKeyConstraint baseColumnNames="ticketdefinitions_ticket_definition_id"
      baseTableName="ticket_definitions_ticket_pool_definitions"
      constraintName="tcktdfntionsticketpooldefinitionstcktdfntionsticketdefinitionid"
      referencedColumnNames="ticket_definition_id" referencedTableName="ticket_definitions"/>
    <addForeignKeyConstraint baseColumnNames="ticketpooldefinitions_ticket_pool_definition_id"
      baseTableName="ticket_definitions_ticket_pool_definitions"
      constraintName="tcktdfntnstcktpooldefinitionstcktpldfntnsticketpooldefinitionid"
      referencedColumnNames="ticket_pool_definition_id"
      referencedTableName="ticket_pool_definitions"/>
  </changeSet>

</databaseChangeLog>
