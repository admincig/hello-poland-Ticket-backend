<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
		 http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <data-source>
        <name>java:module/helloticketDS</name>
        <class-name>org.postgresql.xa.PGXADataSource</class-name>
        <server-name>${jakarta.persistence.jdbc.host}</server-name>
        <port-number>${jakarta.persistence.jdbc.port}</port-number>
        <database-name>${jakarta.persistence.jdbc.database}</database-name>
        <user>${jakarta.persistence.jdbc.user}</user>
        <password>${jakarta.persistence.jdbc.password}</password>
    </data-source>
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
</web-app>
